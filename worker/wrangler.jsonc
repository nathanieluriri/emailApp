{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bridgewood-mail",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "send_email": [{ "name": "EMAIL" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "bridgewood-mail", "database_id": "24734dcb-36ee-4cfc-b11f-5c44cd295471" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "bridgewood-mail" }],
  "vars": {
    "ALLOWED_DOMAIN": "bridgewoodinvestment.ng",
    "PUBLIC_HOST": "bridgewood-mail.uririnathaniel.workers.dev"
  }
}
